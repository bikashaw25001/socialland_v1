PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=
# Gmail 2-Step Verification + an app password are required to send reset email.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
# Reel HLS processing requires FFmpeg on PATH; set an explicit path if needed.
FFMPEG_PATH=
# AV1 MP4 is generated when a compatible AV1 encoder is present. Set false to disable it.
REEL_AV1=true
# FFmpeg encoder name for AV1 output (use libsvtav1 if installed and preferred).
REEL_AV1_ENCODER=libaom-av1
# Nudity detection runs locally in the API process after its model is cached.
CONTENT_MODERATION_MODEL=Rekib23r/nsfw_image_detection-ONNX
CONTENT_MODERATION_THRESHOLD=0.88
CONTENT_MODERATION_CACHE=
